---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Grid from '../components/Grid.astro';
import { aboutData } from '../data/about';
---

<BaseLayout title="About - Interaktif Studio">
  <div class="pt-32 pb-32">
    <!-- Mission -->
    <Container class="mb-32 lg:mb-48">
      <h1 class="display-lg max-w-5xl">
        {aboutData.mission.map((line) => (
          <span class="block">{line}</span>
        ))}
      </h1>
    </Container>

    <!-- Info Table -->
    <Container class="mb-32 lg:mb-48">
      <dl class="border-t border-line">
        {aboutData.info.map((item) => (
          <div class="border-b border-line py-8 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-0">
            <dt class="w-full sm:w-1/3 label-text text-text-muted">{item.label}</dt>
            <dd class="w-full sm:w-2/3 text-lg lg:text-xl">{item.value}</dd>
          </div>
        ))}
      </dl>
    </Container>

    <!-- Values -->
    <Container class="mb-32 lg:mb-48">
      <h2 class="h2 mb-16">Our Values</h2>
      <Grid class="gap-y-12">
        {aboutData.values.map((value) => (
          <div class="col-span-4 sm:col-span-4 lg:col-span-4 flex flex-col gap-4">
            <h3 class="font-display font-medium text-2xl">{value.title}</h3>
            <p class="text-text-muted">{value.description}</p>
          </div>
        ))}
      </Grid>
    </Container>

    <!-- Team -->
    <Container>
      <h2 class="h2 mb-16">The Team</h2>
      <Grid class="gap-y-12">
        {aboutData.team.map((member) => (
          <div class="col-span-2 sm:col-span-4 lg:col-span-2 flex flex-col items-center text-center">
            <div class="w-24 h-24 rounded-full bg-surface-2 mb-6 flex items-center justify-center font-display text-xl text-text-muted">
              {member.name.split(' ').map(n => n[0]).join('')}
            </div>
            <h3 class="font-medium text-lg mb-1">{member.name}</h3>
            <span class="label-text text-text-muted">{member.role}</span>
          </div>
        ))}
      </Grid>
    </Container>
  </div>
</BaseLayout>
