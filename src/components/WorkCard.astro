---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
  class?: string;
  eager?: boolean;
}

const { work, class: className = '', eager = false } = Astro.props;
const { title, date, categories, cover, coverAlt, accentColor } = work.data;

const formattedDate = new Date(date).getFullYear().toString();
const joinedCategories = categories.join(', ');
---

<a 
  href={`/works/${work.id}`} 
  class={`block group cursor-none ${className}`} 
  data-cursor="view"
>
  <div 
    class="relative w-full aspect-[16/10] overflow-hidden bg-surface-2"
    style={`background-color: ${accentColor}33;`}
  >
    <!-- M4: Simple static image. Next milestones will add hover animation -->
    <Picture 
      src={cover} 
      alt={coverAlt} 
      formats={['avif', 'webp']} 
      widths={[480, 768, 1200, 1800]} 
      sizes="(max-width: 768px) 100vw, 50vw" 
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      class="w-full h-full object-cover transition-transform duration-[0.8s] ease-out group-hover:scale-[1.06] origin-center"
    />
  </div>
  
  <div class="mt-4 flex flex-col gap-1">
    <div class="flex justify-between items-start">
      <h3 class="font-display font-medium text-[1.25rem] leading-[1.2] tracking-tight">{title}</h3>
      <span class="label-text text-text-muted mt-1">{formattedDate}</span>
    </div>
    <span class="label-text text-text-muted">{joinedCategories}</span>
  </div>
</a>
