---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  as?: keyof HTMLElementTagNameMap;
}
const { class: className = '', as: Element = 'div', ...rest } = Astro.props;
---
<Element class={`max-w-[1680px] mx-auto px-[clamp(16px,4vw,64px)] ${className}`} {...rest}>
  <slot />
</Element>
