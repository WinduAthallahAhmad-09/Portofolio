---
import { siteConfig } from '../config/site';
---

<div id="preloader" transition:persist="preloader" class="fixed inset-0 bg-bg z-[110] flex items-center justify-center pointer-events-auto origin-top transition-transform">
  <div class="display-lg relative overflow-hidden">
    <div id="preloader-text" class="translate-y-full opacity-0">{siteConfig.name}</div>
  </div>
  <div class="absolute bottom-8 left-[clamp(16px,4vw,64px)] font-mono text-3xl md:text-5xl" id="preloader-counter">000</div>
</div>

<script is:inline>
  // If navigating internally between pages, skip preloader so navigation is instant
  if (window.__spaNavigated) {
    const el = document.getElementById('preloader');
    if (el) el.style.display = 'none';
  }
</script>

<script>
  import { gsap } from 'gsap';

  // Mark internal transitions so clicking links doesn't replay the preloader
  document.addEventListener('astro:before-preparation', () => {
    window.__spaNavigated = true;
  });

  const runPreloader = () => {
    const preloader = document.getElementById('preloader');
    const counter = document.getElementById('preloader-counter');
    const text = document.getElementById('preloader-text');

    if (!preloader) return;

    // If navigating internally via links, bypass preloader
    if (window.__spaNavigated) {
      preloader.style.display = 'none';
      return;
    }

    if (preloader.hasAttribute('data-anim-started')) return;
    preloader.setAttribute('data-anim-started', 'true');

    // Title reveal ("My Studio")
    if (text) {
      gsap.to(text, { y: 0, opacity: 1, duration: 0.6, ease: 'expo.out' });
    }

    // Counter animation 000 -> 100
    const progress = { value: 0 };
    gsap.to(progress, {
      value: 100,
      duration: 1.2,
      ease: 'power2.inOut',
      onUpdate: () => {
        if (counter) {
          counter.textContent = Math.floor(progress.value).toString().padStart(3, '0');
        }
      },
      onComplete: () => {
        // Slide away
        gsap.to(preloader, {
          yPercent: -100,
          duration: 1.35,
          ease: 'power3.inOut',
          onComplete: () => {
            preloader.style.display = 'none';
            window.__spaNavigated = true;
            document.dispatchEvent(new CustomEvent('preloader:complete'));
            document.dispatchEvent(new CustomEvent('intro:start'));
          }
        });
      }
    });
  };

  runPreloader();
  document.addEventListener('astro:page-load', runPreloader);
</script>
