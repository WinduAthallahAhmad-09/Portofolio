---
import Container from './Container.astro';
import RollLink from './RollLink.astro';
import { siteConfig } from '../config/site';

const pathname = Astro.url.pathname;
const links = [
  { label: 'Works', href: '/works' },
  { label: 'Certificate', href: '/certificate' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' }
];

const isActive = (href: string) => {
  if (href === '/' && pathname === '/') return true;
  if (href !== '/' && pathname.startsWith(href)) return true;
  return false;
};
---

<header 
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 transition-transform duration-400 ease-out"
  transition:persist
>
  <Container class="h-16 lg:h-[72px] flex items-center justify-between">
    <a href="/" class="relative z-50 text-xl font-display font-bold tracking-tight" aria-label="Home">
      {siteConfig.name}
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-8 label-text">
      {links.map(link => (
        <RollLink href={link.href} active={isActive(link.href)}>
          {link.label}
        </RollLink>
      ))}
      <button id="sound-toggle-desktop" class="w-6 h-6 flex items-center justify-center gap-[2px]" aria-label="Toggle sound">
        <span class="w-[2px] h-3 bg-text transition-all duration-300"></span>
        <span class="w-[2px] h-4 bg-text transition-all duration-300"></span>
        <span class="w-[2px] h-2 bg-text transition-all duration-300"></span>
      </button>
    </nav>

    <!-- Mobile Toggle -->
    <button 
      id="menu-toggle" 
      class="lg:hidden relative z-50 w-8 h-8 flex flex-col justify-center items-end gap-1.5"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="w-6 h-[2px] bg-text transition-transform origin-right"></span>
      <span class="w-6 h-[2px] bg-text transition-transform origin-right"></span>
    </button>
  </Container>

  <!-- Mobile Menu -->
  <div 
    id="mobile-menu" 
    class="fixed inset-0 bg-surface flex flex-col justify-center px-[clamp(16px,4vw,64px)] opacity-0 pointer-events-none transition-opacity duration-base ease-inout"
    aria-hidden="true"
  >
    <nav class="flex flex-col gap-6">
      {links.map((link, i) => (
        <div class="overflow-hidden">
          <a 
            href={link.href} 
            class="mobile-link block display-lg translate-y-full transition-transform duration-base ease-out"
            style={`transition-delay: ${i * 0.08}s`}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            <span class="flex items-center">
              {isActive(link.href) && <span class="w-3 h-3 rounded-full bg-accent mr-4"></span>}
              {link.label}
            </span>
          </a>
        </div>
      ))}
    </nav>
    <div class="mt-12 overflow-hidden">
      <button 
        id="sound-toggle-mobile" 
        class="mobile-link flex items-center gap-4 label-text translate-y-full transition-transform duration-base ease-out"
        style={`transition-delay: ${links.length * 0.08}s`}
      >
        <div class="w-6 h-6 flex items-center justify-center gap-[2px]">
          <span class="w-[2px] h-3 bg-text"></span>
          <span class="w-[2px] h-4 bg-text"></span>
          <span class="w-[2px] h-2 bg-text"></span>
        </div>
        Sound
      </button>
    </div>
  </div>
</header>

<script>
  // Hide on scroll down, show on scroll up
  let lastScroll = 0;
  const header = document.getElementById('site-header');
  
  const handleScroll = () => {
    if (!header) return;
    const currentScroll = window.scrollY;
    
    // Don't hide if menu is open
    const menuToggle = document.getElementById('menu-toggle');
    if (menuToggle?.getAttribute('aria-expanded') === 'true') return;

    if (currentScroll > 64 && currentScroll > lastScroll) {
      header.style.transform = 'translateY(-100%)';
    } else {
      header.style.transform = 'translateY(0)';
    }
    lastScroll = currentScroll;
  };

  window.addEventListener('scroll', handleScroll, { passive: true });

  // Mobile menu toggle
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');
  const lines = menuToggle?.querySelectorAll('span');

  let menuOpen = false;

  const toggleMenu = (force?: boolean) => {
    if (!menuToggle || !mobileMenu) return;
    menuOpen = force !== undefined ? force : !menuOpen;
    
    menuToggle.setAttribute('aria-expanded', String(menuOpen));
    
    if (menuOpen) {
      mobileMenu.classList.remove('opacity-0', 'pointer-events-none');
      mobileMenu.classList.add('opacity-100', 'pointer-events-auto');
      mobileMenu.setAttribute('aria-hidden', 'false');
      
      mobileLinks.forEach(link => {
        link.classList.remove('translate-y-full');
      });

      if (lines) {
        lines[0].style.transform = 'rotate(-45deg) translateY(1px)';
        lines[1].style.transform = 'rotate(45deg) translateY(-1px)';
      }

      // Mock lenis stop
      if ((window as any).lenis) (window as any).lenis.stop();
      else document.body.style.overflow = 'hidden';
      
    } else {
      mobileMenu.classList.add('opacity-0', 'pointer-events-none');
      mobileMenu.classList.remove('opacity-100', 'pointer-events-auto');
      mobileMenu.setAttribute('aria-hidden', 'true');
      
      mobileLinks.forEach(link => {
        link.classList.add('translate-y-full');
      });

      if (lines) {
        lines[0].style.transform = 'none';
        lines[1].style.transform = 'none';
      }

      if ((window as any).lenis) (window as any).lenis.start();
      else document.body.style.overflow = '';
    }
  };

  menuToggle?.addEventListener('click', () => toggleMenu());
  
  // Focus trap for mobile menu
  const focusableElements = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
  let firstFocusableElement: HTMLElement;
  let lastFocusableElement: HTMLElement;

  const updateFocusableElements = () => {
    if (!mobileMenu) return;
    const focusableContent = mobileMenu.querySelectorAll<HTMLElement>(focusableElements);
    if (focusableContent.length === 0) return;
    firstFocusableElement = focusableContent[0];
    lastFocusableElement = focusableContent[focusableContent.length - 1];
  };

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menuOpen) toggleMenu(false);
    
    if (e.key === 'Tab' && menuOpen) {
      updateFocusableElements();
      if (!firstFocusableElement || !lastFocusableElement) return;

      if (e.shiftKey) {
        if (document.activeElement === firstFocusableElement) {
          lastFocusableElement.focus();
          e.preventDefault();
        }
      } else {
        if (document.activeElement === lastFocusableElement) {
          firstFocusableElement.focus();
          e.preventDefault();
        }
      }
    }
  });
</script>
